DATABASE_URL=postgres://mozza:mozza@localhost:5432/mozza
JWT_SECRET=replace-with-a-long-random-string
# Comma-separated exact API origins. Dev also allows private LAN origins.
WEB_ORIGIN=http://localhost:4321
PORT=8787
HOST=0.0.0.0
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Local admin, seeded only when NODE_ENV is not production.
# Leave these empty in the repo. Put real values in api/.env (gitignored).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Dev: Garage on localhost:3910 (docker compose). Prod: leave R2_ENDPOINT empty
# and set R2_ACCOUNT_ID so the client uses Cloudflare R2.
R2_ENDPOINT=http://127.0.0.1:3910
R2_REGION=garage
R2_FORCE_PATH_STYLE=true
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=GK0123456789abcdef0123456789abcd
R2_SECRET_ACCESS_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
R2_BUCKET=mozza-photos

# Incoming webhook Slack. Vide = aucune notification.
SLACK_WEBHOOK_URL=
