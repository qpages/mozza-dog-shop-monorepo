---
import PhotoGallery from "@/components/photo-gallery.astro";
import { SiteFooter } from "@/components/site-footer";
import Layout from "@/layouts/main.astro";
---

<Layout title="Page introuvable, Mozza Dog Shop">
  <div class="bg-canvas relative flex min-h-screen flex-col">
    <div
      class="pointer-events-none absolute inset-0 opacity-40"
      style="background-image: radial-gradient(rgba(255,255,255,0.16) 0.6px, transparent 0.6px); background-size: 3px 3px;"
      aria-hidden="true"
    >
    </div>

    <header
      class="relative z-10 flex items-center justify-between px-5 py-4 sm:px-8 sm:py-5"
    >
      <a href="/" aria-label="Mozza Dog Shop">
        <img
          src="/logo.png"
          alt=""
          width="600"
          height="338"
          class="h-16 w-auto sm:h-20"
        />
      </a>
      <a
        href="/admin"
        class="type-caption text-paper underline-offset-4 hover:underline focus-visible:underline"
      >
        Espace admin
      </a>
    </header>

    <div
      class="relative z-10 flex flex-1 flex-col items-center justify-center gap-10 py-8"
    >
      <main
        class="copy mx-auto flex w-full max-w-md shrink-0 flex-col gap-5 px-6"
      >
        <div class="text-paper flex flex-col gap-2 text-center">
          <h1 class="type-display">Page introuvable</h1>
          <p class="type-body text-paper/95">Ce lien ne mène à aucune page.</p>
        </div>
        <div class="bg-paper shadow-paper flex flex-col gap-4 rounded-2xl p-5">
          <p class="type-body">
            Vos photos se récupèrent depuis l’accueil, avec l’e-mail du
            shooting.
          </p>
          <a
            href="/"
            class="bg-primary text-primary-foreground hover:bg-primary/80 focus-visible:border-ring focus-visible:ring-3 focus-visible:ring-ring/50 inline-flex h-9 w-full items-center justify-center rounded-lg px-2.5 text-sm font-medium transition-colors focus-visible:outline-none"
          >
            Retour à l’accueil
          </a>
        </div>
      </main>
      <PhotoGallery />
    </div>
    <SiteFooter />
  </div>
</Layout>

<style>
  .copy {
    animation: rise 420ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  @keyframes rise {
    from {
      opacity: 0;
      translate: 0 8px;
    }
    to {
      opacity: 1;
      translate: 0 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .copy {
      animation: none;
    }
  }
</style>
